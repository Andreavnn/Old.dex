{
  "name": "olddex-gui",
  "private": true,
  "version": "0.39.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "node scripts/static-analysis.mjs",
    "check": "npm run lint && npm run test:core && npm run typecheck && npm run build",
    "build:review": "vue-tsc -b && vite build --config vite.review.config.ts && node scripts/inline-preview.mjs && node scripts/verify-preview.mjs",
    "verify:review": "node scripts/verify-preview.mjs",
    "test:core": "node --experimental-strip-types scripts/core-regression.mjs"
  },
  "dependencies": {
    "vue": "3.5.18",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "typescript": "5.8.3",
    "vite": "7.1.2",
    "vue-tsc": "3.0.4"
  }
}
