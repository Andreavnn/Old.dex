{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".test-dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "tests/**/*.ts",
    "src/data/builderPrototype.ts",
    "src/data/listBuilder.ts",
    "src/domain/dataLiteral.ts",
    "src/domain/loadout.ts",
    "src/domain/magicItems.ts",
    "src/domain/rosterTypes.ts",
    "src/domain/schemas.ts",
    "src/domain/selection.ts",
    "src/domain/wizard.ts",
    "src/services/rosterValidation.ts",
    "src/domain/optionDependencies.ts",
    "src/domain/profileEffects.ts",
    "src/data/liveBuilderUnits.ts",
    "src/domain/liveUnitShared.ts",
    "src/domain/rawArmyData.ts",
    "src/services/armyData.ts",
    "src/services/liveUnitReference.ts",
    "src/services/http.ts",
    "src/services/appErrors.ts",
    "src/services/storage.ts",
    "src/services/ruleContent.ts",
    "src/services/ruleText.ts"
  ]
}
